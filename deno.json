{
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite --host",
    // Local clones have a .git, so plain git works. Deno Deploy downloads the
    // source without one, so its build uses fetchsubs instead.
    "submodules": "git submodule update --init --recursive",
    "fetchsubs": "deno run -A scripts/fetch-submodules.ts",
    "locksubs": "deno run -A scripts/lock-submodules.ts",
    "preflight": "deno run -A scripts/check-submodules.ts",
    "buildjelly": {
      "command": "cd submodules/jellysliderxr && deno run -A --node-modules-dir npm:vite build",
      "dependencies": ["preflight"]
    },
    // -c pins each sub-build to its own config. Without it, a missing submodule
    // makes `deno task build` walk up to this file and re-run itself forever.
    "buildflick": {
      "command": "cd submodules/flickmouse && deno task -c deno.json build",
      "dependencies": ["preflight"]
    },
    "buildgol": {
      "command": "cd submodules/GOLXROG && deno task -c deno.json build",
      "dependencies": ["preflight"]
    },
    "getbun": "deno run -A scripts/get-bun.ts",
    "buildmek": {
      "command": "cd submodules/mekgame && deno run -A ../../scripts/run-bun.ts install && deno run -A ../../scripts/run-bun.ts run build",
      "dependencies": ["preflight"]
    },
    "buildvite": "deno run -A --node-modules-dir npm:vite build",
    "build": {
      "command": "deno run -A scripts/build-site.ts",
      "dependencies": [
        "buildjelly",
        "buildflick",
        "buildgol",
        "buildmek",
        "buildvite"
      ]
    },
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "serve": "deno run --allow-net --allow-read jsr:@std/http/file-server _site/"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom"
    ]
  },
  "imports": {
    "@pixiv/three-vrm": "npm:@pixiv/three-vrm@^3.1.1",
    "@react-three/drei": "npm:@react-three/drei@^10.0.8",
    "@react-three/fiber": "npm:@react-three/fiber@^9.1.2", 
    "@types/react": "npm:@types/react@^19.1.4",
    "@types/three": "npm:@types/three@^0.176.0",
    
    "react": "npm:react",
    "react-dom": "npm:react-dom",
    "three": "npm:three@^0.176.0"
  }
}